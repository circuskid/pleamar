// expect: ok
language 0.1
// A service's lists, into models of the scene, record by record, with no logic:
// a field whose type is a model (`networks: nets`), or `list` for the services
// that are only a list.
scene ServiceLists {
    surface { size: 300, 200 }
    permissions { services: "network", "bluetooth", "audio", "window", "workspaces", "apps", "tray", "notifications", "notification_history", "media" }

    model nets max 12 { ssid: text; strength: number; secure: bool; known: bool; active: bool }
    model gadgets max 8 { name: text; address: text; connected: bool; battery: number = -1 }
    model outs max 6 { id: number; name: text; default: bool }
    model ins max 6 { id: number; name: text; default: bool }
    model playing max 6 { id: number; name: text; icon: image 20, 20; volume: number; muted: bool }
    model wins max 8 { title: text; class: text; minimized: bool }
    model spaces max 10 { id: number; name: text; active: bool }
    model launchers max 40 { name: text; exec: text; icon: image 24, 24; keywords: text; terminal: bool; list actions max 4 { name: text; exec: text } }
    model icons max 12 { key: text; title: text; icon: image 18, 18; tooltip: text; tooltip_body: text }
    model notices max 14 { app: text; title: text; body: text; image: image 32, 32; time: number }
    model missed max 20 { app: text; title: text }
    model choices max 8 { id: text; name: text; playing: bool; chosen: bool }

    service network as net { online: bool; networks: nets }
    service bluetooth as bt { powered: bool; devices: gadgets }
    service audio { volume: number; outputs: outs; inputs: ins; apps: playing }
    service window { title: text; list: wins }
    service workspaces as ws { active: number; list: spaces }
    service apps { list: launchers }
    service tray { list: icons }
    service notifications { list: notices }
    service notification_history { list: missed }
    service media as song { players: choices }

    for n in nets { text n.ssid { at: 10, 40; size: 12; color: #fff } }
}
