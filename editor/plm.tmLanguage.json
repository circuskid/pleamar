{
  "$comment": "Made by `pleamar --highlight vscode`: it is not written by hand.",
  "fileTypes": [
    "plm"
  ],
  "name": "pleamar",
  "patterns": [
    {
      "match": "//.*$",
      "name": "comment.line.double-slash.plm"
    },
    {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.plm",
      "patterns": [
        {
          "match": "\\{[^}]*\\}",
          "name": "variable.other.plm"
        }
      ]
    },
    {
      "match": "#[0-9a-fA-F]{3,8}\\b",
      "name": "constant.other.colour.plm"
    },
    {
      "match": "\\b\\d+(\\.\\d+)?(px|%|deg|ms|s)?\\b",
      "name": "constant.numeric.plm"
    },
    {
      "match": "\\b\\w+(?=\\s*:)",
      "name": "entity.other.attribute-name.plm"
    },
    {
      "match": "\\b(surface|permissions|model|service|spring|prop|pose|fact|event|text|image|figure|font|shader|blur|particles|measure|let|zone|body|ellipse|box|arc|line|path|input|clip|group|popup|component|children|repeat|for|row|column|grid|pages|space|between|layer|on|every|blink|wave|spin|follow|look|gesture|posture|translations|windows|window|scene|library|import|language|part|include)\\b",
      "name": "keyword.control.plm"
    },
    {
      "match": "\\b(in|max|while|for|after|from|until|at|by|reach|within|rest|inset|right|middle|as|via|strict|each|all)\\b",
      "name": "keyword.other.plm"
    },
    {
      "match": "\\b(min|max|abs|floor|ceil|sin|cos|clamp|smooth|mix|if|vel|sqrt|pow|fract|mod|sign|round|exp|log|tan|atan2|length|noise|random|pick|rgb|upper|lower)\\b",
      "name": "support.function.plm"
    },
    {
      "match": "\\b(press|release|scroll|drag|hold|enter|leave|hover|away|idle|key|submit|focus|blur|drop|carry|change|still)\\b",
      "name": "entity.name.tag.plm"
    },
    {
      "match": "\\b(toggle|emit|impulse|ripple|play|focus|blur|close|promote|fullscreen|minimize|restore|float|tile|launch|send|swap|workspace|pick|dock)\\b",
      "name": "keyword.operator.plm"
    },
    {
      "match": "\\b(move|line|curve|close)\\b",
      "name": "storage.type.plm"
    },
    {
      "match": "\\b(true|false|lively|calm|quick|slow|gentle|pose|linear|in_quad|out_quad|in_cubic|out_cubic|in_out_sine|out_back|bezier)\\b",
      "name": "constant.language.plm"
    },
    {
      "match": "~\\w+",
      "name": "support.constant.spring.plm"
    }
  ],
  "scopeName": "source.plm"
}
